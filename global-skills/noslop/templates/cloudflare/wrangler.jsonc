// Passcode-gated page at https://{{SHARE_DOMAIN}}/{{WORKER_NAME}}/ (noslop skill, web version).
// Deploy: cloudflare.sh wrangler deploy. Passcode: cloudflare.sh wrangler secret put PASSCODE.
{
  "name": "{{WORKER_NAME}}",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  // The page's built files. Every request goes through worker.js first, so nothing is served
  // without the passcode.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Its own path on the shared host: /{{WORKER_NAME}} and everything under it. The name ends in
  // a random hash, so no two pages share a route.
  "routes": [
    { "pattern": "{{SHARE_DOMAIN}}/{{WORKER_NAME}}", "zone_name": "{{SHARE_ZONE}}" },
    { "pattern": "{{SHARE_DOMAIN}}/{{WORKER_NAME}}/*", "zone_name": "{{SHARE_ZONE}}" }
  ],
  // No second, unlisted address on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Shown on the passcode screen, e.g. "October update for Dana". Not secret.
    "PAGE_TITLE": "Private page",
    // The page's path on the shared host. Build the page with relative asset links.
    "BASE_PATH": "/{{WORKER_NAME}}",
    // After this date (UTC) the gate answers "expired", and `cloudflare.sh prune` lists the page.
    "EXPIRES": "{{EXPIRES}}",
    // Link previews (Teams, Slack, Outlook, iMessage) only ever see the passcode screen. Anyone
    // holding the link sees this text, so keep it generic: no names, numbers or findings.
    "SHARE_DESCRIPTION": "{{SHARE_DESCRIPTION}}",
    // From the ai-config profile (favicon, touch_icon, share_image). Each must be a public https
    // URL outside this page's path, since everything under the path sits behind the passcode.
    // Empty leaves the tag out.
    "FAVICON": "{{FAVICON}}",
    "TOUCH_ICON": "{{TOUCH_ICON}}",
    "SHARE_IMAGE": "{{SHARE_IMAGE}}"
  }
}
