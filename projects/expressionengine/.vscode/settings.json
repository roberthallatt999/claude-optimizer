{
  // Editor Settings (codebase conventions only: rulers, wrapping and other personal
  // preferences belong in your own user settings, which apply here and in dev containers)
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,

  // PHP Settings
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4
  },

  // HTML/Template Settings
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  // CSS/SCSS Settings
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // JavaScript Settings
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  // JSON Settings
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },

  // File Settings
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.DS_Store": true
  },
  "files.associations": {
    "**/user/templates/**/*.html": "expressionengine"
  },

  // Search Settings
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/system/ee": true,
    "**/.git": true,
    "**/cache": true
  },

  // Emmet Settings for EE Templates
  "emmet.includeLanguages": {
    "expressionengine": "html"
  },

  // Tailwind CSS Settings (if using Tailwind)
  "tailwindCSS.includeLanguages": {
    "expressionengine": "html"
  },
  "tailwindCSS.emmetCompletions": true,

  // PHP Intelephense Settings
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/system/ee/**"
  ]
}
