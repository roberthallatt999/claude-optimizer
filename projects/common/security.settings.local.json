{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo delete:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(bun publish:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy:*)",
      "Bash(netlify deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(ddev push:*)",
      "Bash(ddev delete:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(**/*-credentials.json)",
      "Read(**/*.cer)",
      "Read(**/*.crt)",
      "Read(**/*.csr)",
      "Read(**/*.der)",
      "Read(**/*.jks)",
      "Read(**/*.key)",
      "Read(**/*.keystore)",
      "Read(**/*.log)",
      "Read(**/*.p12)",
      "Read(**/*.password)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.priv)",
      "Read(**/*.secret)",
      "Read(**/*.secrets)",
      "Read(**/*.token)",
      "Read(**/*service-account*.json)",
      "Read(**/.aws/config)",
      "Read(**/.aws/credentials)",
      "Read(**/.azure/*)",
      "Read(**/.ddev/db_snapshots/*)",
      "Read(**/.ddev/import-db/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git-credentials)",
      "Read(**/.htpasswd)",
      "Read(**/.my.cnf)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pgpass)",
      "Read(**/.pypirc)",
      "Read(**/.ssh/*)",
      "Read(**/.yarnrc)",
      "Read(**/application_default_credentials.json)",
      "Read(**/auth.json)",
      "Read(**/config.local.php)",
      "Read(**/config.php)",
      "Read(**/credentials.json)",
      "Read(**/database.yaml)",
      "Read(**/database.yml)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.pub)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.pub)",
      "Read(**/logs/*)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/storage/logs/*)",
      "Read(**/system/user/config/config.php)",
      "Read(**/vault.yaml)",
      "Read(**/vault.yml)",
      "Read(**/wp-config-local.php)",
      "Read(**/wp-config.php)",
      "Read(**/wp-salt.php)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
